# Synthetic, non-production configuration. Copy to .env and fill in local values.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=water_app
DB_PASSWORD=
DB_NAME=water_allowance
DB_CONN_LIMIT=5

DB_SSL_ENABLED=false
# DB_SSL_CA=/absolute/path/to/ca.pem
PORT=3000
# Only enable for a verified trusted reverse proxy.
TRUST_PROXY=false

# Fails closed unless credentials are supplied. For unauthenticated loopback-only
# development, explicitly use APP_AUTH_ENABLED=false.
APP_AUTH_ENABLED=true
APP_USERNAME=
APP_PASSWORD=
APP_AUTH_REALM=Water Allowance

# Synthetic example baseline - not a real household reading.
DEFAULT_BASELINE_DATE=2026-01-01
DEFAULT_BASELINE_READING=100000
DEFAULT_DAILY_ALLOWANCE=800
